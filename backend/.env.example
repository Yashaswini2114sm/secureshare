# ═══════════════════════════════════════════════════════════════════
# SecureShare Environment Configuration
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and customize the values:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────
APP_NAME=SecureShare
DEBUG=true

# ── Database ─────────────────────────────────────────────────────
# SQLite (for local development — no setup needed):
DATABASE_URL=sqlite+aiosqlite:///./secureshare.db

# PostgreSQL (for Docker / production):
# DATABASE_URL=postgresql+asyncpg://secureshare:secureshare_password@localhost:5432/secureshare_db

# ── JWT Authentication ───────────────────────────────────────────
# IMPORTANT: Change this to a random string in production!
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# ── File Storage ─────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=100

# ── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
